{
    "name": "spiggle/geo-lock",
    "description": "Decide which Filament roles can open the panel from which countries and regions.",
    "type": "library",
    "version": "1.1.0",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filamentphp",
        "geo-lock",
        "access",
        "spiggle"
    ],
    "authors": [
        {
            "name": "Spiggle"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": ">=11.0",
        "illuminate/database": ">=11.0",
        "illuminate/http": ">=11.0",
        "spatie/laravel-permission": "^6.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Also write each denial into the application activity log."
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\GeoLock\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\GeoLock\\GeoLockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
